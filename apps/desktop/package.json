{
	"name": "desktop",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "concurrently \"bun run hmr\" \"electrobun dev --watch\"",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5174",
		"build:canary": "vite build && electrobun build --env=canary",
		"db:push": "bun x --bun drizzle-kit push",
		"db:generate": "drizzle-kit generate"
	},
	"dependencies": {
		"drizzle-orm": "^1.0.0-beta.22",
		"electrobun": "^1.18.1",
		"env-paths": "^4.0.0",
		"mode-watcher": "^1.1.0",
		"sv-router": "latest"
	},
	"devDependencies": {
		"@fontsource-variable/geist": "^5.2.9",
		"@lucide/svelte": "^1.20.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.3.0",
		"bun-types": "^1.3.14",
		"clsx": "^2.1.1",
		"concurrently": "^10.0.3",
		"drizzle-kit": "^1.0.0-beta.22",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.3.0",
		"svelte": "^5.55.3",
		"svelte-check": "^4.4.6",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.8"
	}
}
